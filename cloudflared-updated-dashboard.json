{
  "dashboard": {
    "id": null,
    "title": "🚀 Leo Profi - Cloudflared Monitoring (Atualizado)",
    "tags": ["cloudflared", "tunnel", "leoprofi"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "🌐 Tunnel Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"cloudflared\"}",
            "legendFormat": "Tunnel Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "unit": "none",
            "mappings": [
              {"options": {"0": {"text": "DOWN"}}, "type": "value"},
              {"options": {"1": {"text": "UP"}}, "type": "value"}
            ]
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "auto"
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "📊 Total de Requisições",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(cloudflared_tunnel_total_requests[5m])",
            "legendFormat": "Requests/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "🔗 Conexões HA",
        "type": "stat",
        "targets": [
          {
            "expr": "cloudflared_tunnel_ha_connections",
            "legendFormat": "HA Connections"
          }
        ],
        "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0}
      },
      {
        "id": 4,
        "title": "⚡ Requisições Concorrentes",
        "type": "graph",
        "targets": [
          {
            "expr": "cloudflared_tunnel_concurrent_requests_per_tunnel",
            "legendFormat": "Concurrent Requests"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 5,
        "title": "❌ Erros de Requisição",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(cloudflared_tunnel_request_errors[5m])",
            "legendFormat": "Errors/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "🌍 Localizações do Servidor",
        "type": "stat",
        "targets": [
          {
            "expr": "cloudflared_tunnel_server_locations",
            "legendFormat": "{{location}}"
          }
        ],
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 7,
        "title": "📈 Respostas por Código HTTP",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(cloudflared_tunnel_response_by_code[5m])",
            "legendFormat": "{{code}}"
          }
        ],
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  },
  "folderId": 0,
  "overwrite": true
}